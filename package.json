{
  "name": "respectlytics",
  "version": "1.0.0",
  "description": "A privacy-first mobile analytics backend built with Django and Django REST Framework.",
  "scripts": {
    "build:css": "tailwindcss -i ./static/css/tailwind-input.css -o ./static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./static/css/tailwind-input.css -o ./static/css/tailwind.css --watch",
    "test:tools": "playwright test --config tests/playwright/playwright.config.js",
    "test:tools:install": "playwright install --with-deps chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "playwright": "^1.60.0",
    "tailwindcss": "^3.4.1"
  }
}
